{
	"name": "ozone-sdk",
	"private": true,
	"license": "ISC",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"build": "yarn workspace @taktik/ozone-type build && yarn workspace @taktik/ozone-client build",
		"typecheck": "yarn workspace @taktik/ozone-type typecheck && yarn workspace @taktik/ozone-client typecheck",
		"check:dist": "yarn workspace @taktik/ozone-client check:dist",
		"lint": "eslint packages *.mjs *.mts",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write \"packages/*/{src,test}/**/*.ts\" \"*.{ts,mts,mjs,json,md}\"",
		"prepare": "husky"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/chai": "^5.2.3",
		"@types/nise": "^1.4.5",
		"@types/sinon": "^22.0.0",
		"chai": "^6.2.2",
		"eslint": "^10.11.0",
		"eslint-config-prettier": "^10.1.8",
		"husky": "^9.1.7",
		"jsdom": "^30.1.1",
		"lint-staged": "^17.5.1",
		"nise": "^6.1.5",
		"prettier": "^3.9.9",
		"sinon": "^22.1.0",
		"tsup": "^8.5.1",
		"typescript": "^5",
		"typescript-eslint": "^8.70.1",
		"vite": "^7",
		"vitest": "^5.0.1"
	}
}
