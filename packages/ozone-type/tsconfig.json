{
	"compilerOptions": {
		"target": "es6",
		"module": "esnext",
		"moduleResolution": "node",
		"experimentalDecorators": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strictNullChecks": true,
		"noImplicitThis": true,
		"noImplicitAny": true,
		"lib": ["es2017", "es6", "es5", "dom"]
	},
	"include": ["ozone", "tsup.config.ts"]
}
