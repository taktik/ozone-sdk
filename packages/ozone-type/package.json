{
	"name": "@taktik/ozone-type",
	"version": "1.0.0",
	"description": "Ozone API types, generated from the server swagger",
	"license": "ISC",
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/taktik/ozone-sdk.git",
		"directory": "packages/ozone-type"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit"
	},
	"publishConfig": {
		"registry": "https://npm.taktik.be/repository/npm/"
	}
}
