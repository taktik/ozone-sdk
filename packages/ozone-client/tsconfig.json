{
	"compilerOptions": {
		"target": "es6",
		"module": "esnext",
		"moduleResolution": "node",
		"experimentalDecorators": true,
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"baseUrl": ".",
		"paths": {
			"@taktik/ozone-type": ["../ozone-type/ozone/index.ts"]
		},
		"types": ["vitest/globals"],
		"strictNullChecks": true,
		"noImplicitThis": true,
		"allowSyntheticDefaultImports": true,
		"lib": ["es2017", "es2015", "es6", "es5", "dom", "esnext"]
	},
	"include": ["src", "test", "tsup.config.ts"]
}
