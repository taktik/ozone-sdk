{
	"compilerOptions": {
		"target": "es6",
		"module": "esnext",
		"moduleResolution": "node",
		"experimentalDecorators": true,
		"strict": true,
		"strictNullChecks": true,
		"noImplicitThis": true,
		"allowSyntheticDefaultImports": true,
		"lib": [
			"es2017",
			"es2015",
			"es6",
			"es5",
			"dom",
			"esnext"
		],
		"declaration": true,
		"sourceMap": true,
		"rootDir": "./src",
		"outDir": "./dist"
	},
	"files": [
		"./src/index.ts",
		"./src/search/index.ts",
		"./src/urls/index.ts"
	]
}
