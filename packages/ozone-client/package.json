{
	"name": "@taktik/ozone-client",
	"version": "1.0.0",
	"description": "TypeScript client for Ozone: HTTP, WebSocket and the typed sub-clients",
	"license": "ISC",
	"private": false,
	"main": "dist/index.js",
	"module": "dist/index.mjs",
	"types": "dist/index.d.ts",
	"sideEffects": false,
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.mjs",
			"require": "./dist/index.js"
		},
		"./search": {
			"types": "./dist/search.d.ts",
			"import": "./dist/search.mjs",
			"require": "./dist/search.js"
		},
		"./urls": {
			"types": "./dist/urls.d.ts",
			"import": "./dist/urls.mjs",
			"require": "./dist/urls.js"
		},
		"./default": {
			"types": "./dist/default.d.ts",
			"import": "./dist/default.mjs",
			"require": "./dist/default.js"
		},
		"./upload": {
			"types": "./dist/upload.d.ts",
			"import": "./dist/upload.mjs",
			"require": "./dist/upload.js"
		}
	},
	"typesVersions": {
		"*": {
			"search": [
				"dist/search.d.ts"
			],
			"urls": [
				"dist/urls.d.ts"
			],
			"default": [
				"dist/default.d.ts"
			],
			"upload": [
				"dist/upload.d.ts"
			]
		}
	},
	"files": [
		"dist"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/taktik/ozone-sdk.git",
		"directory": "packages/ozone-client"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "npm run build"
	},
	"dependencies": {
		"@taktik/ozone-type": "1.0.0",
		"generic-logger-typings": "1.0.0",
		"helpful-decorators": "2.0.4",
		"sockjs-client": "1.4.0",
		"typescript-http-client": "0.10.5",
		"typescript-state-machine": "0.9.9"
	},
	"devDependencies": {
		"@types/sockjs-client": "^1.1.1"
	},
	"publishConfig": {
		"registry": "https://npm.taktik.be/repository/npm/"
	}
}
